# Copy to backend/.env (never commit secrets to Git)
# Get Supabase keys from: https://supabase.com/dashboard/project/mkurfdbznwhgocecombq/settings/api-keys
SUPABASE_URL=https://mkurfdbznwhgocecombq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional DeepSeek key for cloud Copilot chat. Takes precedence over Gemini for chat.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional Gemini key for AI document parsing and Copilot chat when DeepSeek is unset
GEMINI_API_KEY=

# Signing secret for user session tokens and admin key for ML retraining.
# In production (MDIP_ENV=production or on Render) the server will not start unless
# MDIP_AUTH_SECRET is set to at least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MDIP_AUTH_SECRET=
MDIP_ADMIN_KEY=change-this-admin-key

# Set to "production" when deploying outside Render (Render is detected automatically)
MDIP_ENV=

# Browser origins allowed to call the API, comma-separated (e.g. your Vercel URL).
# Leave empty for the local defaults (localhost:3000 and localhost:3100).
MDIP_CORS_ORIGINS=

# Firebase project whose Auth ID tokens the API accepts (empty = Firebase sign-in not accepted)
FIREBASE_PROJECT_ID=

# Google OAuth Web Client ID for Sign in with Google (must match NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Production review grants: JSON mapping signed account identities to plant roles.
# MDIP_DECISION_REVIEWERS={"supabase:SUPABASE_USER_UUID":"Plant Manager","mdip:ACCOUNT_ID":"Operations Manager"}
